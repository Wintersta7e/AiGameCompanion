{
  // Type-check context for Node code: the package-root config files (attached
  // by typescript-eslint through projectService.defaultProject) and the gate
  // helpers under scripts/ (listed in include, linted through their own eslint
  // block).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["scripts/*.ts"],
  "references": [{ "path": "./tsconfig.json" }]
}
